<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema real de la app: oscuro siempre, sin destello blanco al arrancar. -->
    <style name="Theme.VITTHER" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Pantalla de arranque: negro museo + emblema dorado. -->
    <style name="Theme.VITTHER.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.VITTHER</item>
    </style>

</resources>
